    {
      "name": "Negative Test Cases",
      "item": [
        {
          "name": "Duplicate Enrolment (Expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 409 Conflict for duplicate enrolment', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 1,\n  \"batchId\": 1,\n  \"enrolmentDate\": \"2026-11-25\",\n  \"status\": \"ENROLLED\",\n  \"attendancePercentage\": 0.00,\n  \"remarks\": \"Duplicate enrolment test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enrolments",
              "host": ["{{baseUrl}}"],
              "path": ["enrolments"]
            }
          }
        },
        {
          "name": "Batch Capacity Exceeded (Expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 409 Conflict or 400 Bad Request when batch is full', function () {",
                  "    pm.expect([400, 409]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 6,\n  \"batchId\": {{fullBatchId}},\n  \"enrolmentDate\": \"2026-11-25\",\n  \"status\": \"ENROLLED\",\n  \"attendancePercentage\": 0.00,\n  \"remarks\": \"Capacity exceeded test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enrolments",
              "host": ["{{baseUrl}}"],
              "path": ["enrolments"]
            }
          }
        },
        {
          "name": "Invalid Batch Date Range (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 400 Bad Request when endDate precedes startDate', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchCode\": \"BTH-BAD-DATE\",\n  \"batchName\": \"Invalid Date Range Batch\",\n  \"courseId\": 1,\n  \"trainerId\": 1,\n  \"startDate\": \"2026-12-15\",\n  \"endDate\": \"2026-12-01\",\n  \"scheduleTimings\": \"Mon-Fri 10:00 AM\",\n  \"mode\": \"ONLINE\",\n  \"maxCapacity\": 15,\n  \"status\": \"UPCOMING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches",
              "host": ["{{baseUrl}}"],
              "path": ["batches"]
            }
          }
        },
        {
          "name": "Invalid Attendance Percentage (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 400 Bad Request when attendance > 100', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attendancePercentage\": 120.00,\n  \"remarks\": \"Out of range test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enrolments/{{enrolmentId}}/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["enrolments", "{{enrolmentId}}", "attendance"]
            }
          }
        }
      ]
